+bool vmcache_canBeEvicted(ucache::Buffer* buf) {
+   PID pid = bm->toPID(buf->baseVirt);
+   auto expectedVMAddress = reinterpret_cast<u64>(bm->toPtr(pid));
+   ucache::assert_crash(buf->baseVirt == bm->toPtr(pid));
